import json
import requests
from tqdm import tqdm

# 定义三类关键词（你可以根据 squad 题目类别扩展）
COMMON_SENSE_KEYWORDS = ['born', 'capital', 'president', 'year', 'war', 'city']
NICHE_KEYWORDS = ['tentilla', 'apicoplasts', 'interleukins', 'ctenophores', 'probe']

def classify_knowledge_type(question):
    q_lower = question.lower()
    if any(k in q_lower for k in COMMON_SENSE_KEYWORDS):
        return "High-Saliency"
    if any(k in q_lower for k in NICHE_KEYWORDS):
        return "Low-Saliency"
    return "Medium-Saliency"

def run_deep_dive_1000():
    # 假设你已经有 scale_1000_conflict.py 跑完的 json
    with open("rag_conflict_1000.json", "r") as f:
        data = json.load(f)
    
    deep_stats = {
        "High-Saliency": {"Adherence": 0, "Persistence": 0, "Other": 0},
        "Medium-Saliency": {"Adherence": 0, "Persistence": 0, "Other": 0},
        "Low-Saliency": {"Adherence": 0, "Persistence": 0, "Other": 0}
    }

    for item in data:
        k_type = classify_knowledge_type(item['q'])
        label = item['label']
        if label == "Uncertain/Other": label = "Other"
        deep_stats[k_type][label] += 1

    print(json.dumps(deep_stats, indent=4))
    return deep_stats

# 运行统计分析，这组数据将是你报告第 3 页的核心图表来源
stats = run_deep_dive_1000()